{
  "name": "last-slice",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @last-slice/api run dev",
    "dev:web": "npm --workspace @last-slice/web run dev",
    "build": "npm --workspace @last-slice/contracts run build && npm --workspace @last-slice/api run build && npm --workspace @last-slice/web run build",
    "test:tracking": "npm run test:tracking:api && playwright test",
    "test:tracking:api": "node --import tsx --test tests/order-tracking.api.test.ts",
    "dev:api:ai": "python3 scripts/run-api-with-vault.py",
    "dev:ai": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api:ai\" \"npm:dev:web\"",
    "test:api": "node --import tsx --test tests/*.test.ts",
    "dev:public": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api:public\" \"npm:dev:web\"",
    "dev:api:public": "KITCHEN_MODE=public-demo npm run dev:api",
    "dev:public:ai": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api:public:ai\" \"npm:dev:web\"",
    "dev:api:public:ai": "KITCHEN_MODE=public-demo python3 scripts/run-api-with-vault.py"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
