# API runtime, never supplied to customer builds. Do not put real credentials here.
PORT=3001
KITCHEN_MODE=public-demo
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-runtime-secret-store
ASSISTANT_PROVIDER=openai
ASSISTANT_MODEL=gpt-5-nano-2025-08-07
# Local development: make dev-public-ai reads OPENAI_API_KEY from your existing vault session.
# Hosted API: inject ASSISTANT_API_KEY through the hosting secret store.
# Web build only: VITE_API_URL=https://your-demo-api.example
